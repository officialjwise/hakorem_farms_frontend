{
  "name": "hakorem-farms-frontend",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.9",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "setup": "pnpm install --frozen-lockfile && pnpm tokens:check && pnpm fonts:check && pnpm icons:check",
    "tokens": "pnpm --filter @hakorem/ui tokens",
    "tokens:check": "pnpm --filter @hakorem/ui tokens:check",
    "fonts": "pnpm --filter @hakorem/ui fonts",
    "fonts:check": "pnpm --filter @hakorem/ui fonts:check",
    "lint": "eslint . --max-warnings 0 && stylelint \"**/*.css\" --max-warnings 0",
    "typecheck": "pnpm -r typecheck",
    "test:unit": "pnpm -r test:unit",
    "test:integration": "pnpm --filter @hakorem/console --filter @hakorem/storefront --workspace-concurrency=1 test:integration",
    "test:a11y": "pnpm --filter @hakorem/ui test:stories",
    "storybook": "pnpm --filter @hakorem/ui storybook",
    "build-storybook": "pnpm --filter @hakorem/ui build-storybook",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:storefront": "pnpm --filter @hakorem/storefront dev",
    "dev:console": "pnpm --filter @hakorem/console dev",
    "dev:mock": "prism mock contract/openapi.yaml --host 127.0.0.1 --port 4010",
    "build:storefront": "pnpm --filter @hakorem/storefront build",
    "build:console": "pnpm --filter @hakorem/console build",
    "budget:console": "pnpm --filter @hakorem/console budget",
    "icons:check": "pnpm --filter @hakorem/console icons:check",
    "test:e2e": "HK_API_BASE_URL=/mock HK_REQUESTED_CONTRACT=CR-032,CR-033,CR-038,CR-042,CR-045 pnpm build:console && HK_API_BASE_URL=http://127.0.0.1:4010 pnpm build:storefront && pnpm --filter @hakorem/e2e test",
    "screenshots": "HK_API_BASE_URL=/mock HK_REQUESTED_CONTRACT=CR-032,CR-033,CR-038,CR-042,CR-045 pnpm build:console && HK_API_BASE_URL=http://127.0.0.1:4010 pnpm build:storefront && pnpm --filter @hakorem/e2e screenshots",
    "test:e2e:quarantine": "HK_API_BASE_URL=/mock HK_REQUESTED_CONTRACT=CR-032,CR-033,CR-038,CR-042,CR-045 pnpm build:console && HK_API_BASE_URL=http://127.0.0.1:4010 pnpm build:storefront && pnpm --filter @hakorem/e2e test:quarantine",
    "sync-contract": "./scripts/sync-contract.sh",
    "sync-contract:check": "./scripts/sync-contract.sh --check",
    "sync-contract:github": "./scripts/sync-contract.sh --github"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@hakorem/lint-tokens": "workspace:*",
    "@stoplight/prism-cli": "5.16.0",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "stylelint": "17.16.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  }
}
